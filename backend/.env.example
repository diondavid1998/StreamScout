# Copy this to .env and fill in your values
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# TMDB → https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# OMDB → https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key

# Watchmode → https://api.watchmode.com/  (optional)
# Pros/cons summaries and rent/buy prices on the title sheet. The quota is a
# LIFETIME figure, not monthly, so this is only ever called for a title someone
# has opened, and the answer is cached forever. Leave unset to turn it off.
WATCHMODE_API_KEY=your_watchmode_api_key

# Comma-separated list of allowed frontend origins (no trailing slashes)
# On Render set this to your Netlify URL + localhost
FRONTEND_URL=https://screenscoretest.netlify.app,http://localhost:3000
